<!DOCTYPE html>\x0a<html>\x0a\x0a<head>\x0a\x0a<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">\x0a\x0a<!--<link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Architects+Daughter">-->\x0a<link rel="stylesheet" type="text/css" href="stylesheets/stylesheet.css" media="screen" />\x0a<link rel="shortcut icon" href="images/favicon.ico" type="image/x-icon" />\x0a\x0a<!--<script src="//html5shiv.googlecode.com/svn/trunk/html5.js"></script>-->\x0a<script src="js/html5.js"></script>\x0a\x0a<title>bWAPP - Login</title>\x0a\x0a</head>\x0a\x0a<body>\x0a\x0a<header>\x0a\x0a<h1>bWAPP</h1>\x0a\x0a<h2>an extremely buggy web app !</h2>\x0a\x0a</header>\x0a\x0a<div id="menu">\x0a\x0a    <table>\x0a\x0a        <tr>\x0a\x0a            <td><font color="#ffb717">Login</font></td>\x0a            <td><a href="user_new.php">New User</a></td>\x0a            <td><a href="info.php">Info</a></td>\x0a            <td><a href="training.php">Talks & Training</a></td>\x0a            <td><a href="http://itsecgames.blogspot.com" target="_blank">Blog</a></td>\x0a\x0a        </tr>\x0a\x0a    </table>\x0a\x0a</div>\x0a\x0a<div id="main">\x0a\x0a    <h1>Login</h1>\x0a\x0a    <p>Enter your credentials <i>(bee/bug)</i>.</p>\x0a\x0a    <form action="/bWAPP/login.php" method="POST">\x0a\x0a        <p><label for="login">Login:</label><br />\x0a        <input type="text" id="login" name="login" size="20" autocomplete="off"></p> \x0a\x0a        <p><label for="password">Password:</label><br />\x0a        <input type="password" id="password" name="password" size="20" autocomplete="off"></p>\x0a\x0a        <p><label for="security_level">Set the security level:</label><br />\x0a\x0a        <select name="security_level">\x0a\x0a            <option value="0">low</option>\x0a            <option value="1">medium</option>\x0a            <option value="2">high</option>\x0a\x0a        </select>\x0a\x0a        </p>\x0a\x0a        <button type="submit" name="form" value="submit">Login</button>\x0a\x0a    </form>\x0a\x0a    <br />\x0a    \x0a</div>\x0a\x0a<div id="sponsor_2">\x0a\x0a    <table>\x0a\x0a        <tr>\x0a\x0a            <td width="103" align="center"><a href="https://www.owasp.org" target="_blank"><img src="./images/owasp.png"></a></td>\x0a            <td width="102" align="center"><a href="https://www.owasp.org/index.php/OWASP_Zed_Attack_Proxy_Project" target="_blank"><img src="./images/zap.png"></a></td>\x0a            <td width="110" align="center"><a href="https://www.netsparker.com/?utm_source=bwappapp&utm_medium=banner&utm_campaign=bwapp" target="_blank"><img src="./images/netsparker.png"></a></td>\x0a            <td width="152" align="center"><a href="http://www.missingkids.com" target="_blank"><img src="./images/mk.png"></a></td>\x0a\x0a        </tr>\x0a\x0a    </table>\x0a\x0a    <br />\x0a\x0a    <table>\x0a\x0a        <tr>\x0a\x0a            <td width="288" align="right"><a href="http://www.mmebvba.com" target="_blank"><img src="./images/mme.png"></a></td>\x0a            <td width="190" align="right"><a href="https://www.netsparker.com/?utm_source=bwappapp&utm_medium=banner&utm_campaign=bwapp" target="_blank"><img src="./images/netsparker.gif"></a></td>\x0a\x0a        </tr>\x0a\x0a    </table>\x0a\x0a</div>\x0a\x0a<div id="side">\x0a\x0a    <a href="http://twitter.com/MME_IT" target="blank_" class="button"><img src="./images/twitter.png"></a>\x0a    <a href="http://be.linkedin.com/in/malikmesellem" target="blank_" class="button"><img src="./images/linkedin.png"></a>\x0a    <a href="http://www.facebook.com/pages/MME-IT-Audits-Security/104153019664877" target="blank_" class="button"><img src="./images/facebook.png"></a>\x0a    <a href="http://itsecgames.blogspot.com" target="blank_" class="button"><img src="./images/blogger.png"></a>\x0a\x0a</div>\x0a\x0a<div id="disclaimer">\x0a\x0a    <p>bWAPP is licensed under <a rel="license" href="http://creativecommons.org/licenses/by-nc-nd/4.0/" target="_blank"><img style="